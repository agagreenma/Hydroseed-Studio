# HYDROSEED Studio Environment Variables
# 
# Copy this file to .env.local and fill in the actual values from your
# Supabase project dashboard. Values in this file are examples only.
# 
# Never commit actual .env files with real credentials to version control.

# Supabase project ID (from project settings)
SUPABASE_PROJECT_ID=

# Supabase publishable/anon key (from API settings, starts with sb_anon_)
SUPABASE_PUBLISHABLE_KEY=

# Supabase project URL (from project settings, e.g., https://xxxxx.supabase.co)
SUPABASE_URL=

# Vite-injected variables for client-side access (build-time replacement)
VITE_SUPABASE_PROJECT_ID=

# Vite-injected Supabase publishable key (visible in bundle by design)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Vite-injected Supabase project URL (required by client library)
VITE_SUPABASE_URL=

# Optional: Override the Studio public URL (defaults to https://studio.hydroseed.app)
# VITE_STUDIO_PUBLIC_URL=http://localhost:8080
